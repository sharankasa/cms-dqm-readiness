  "element_rules": [
    {
      "role": "glucose_result",
      "resource": "Observation",
      "element": "valueQuantity (UCUM, mass per volume)",
      "rule": "value compared with mg/dL thresholds (40, 80, 200, 300, 600); CMS FHIRHelpers.ToQuantity accepts UCUM units only",
      "used_by": [
        "CMS816: Glucose Test With Result Less Than 40, Low Glucose Test Followed By Glucose Test Result Greater Than 80",
        "CMS871: Encounter with Elevated Glucose Greater Than or Equal to 200, Days with Hyperglycemic Events, Glucose Greater Than 600 ..."
      ]
    },
    {
      "role": "glucose_result",
      "resource": "Observation",
      "element": "effective[x]",
      "rule": "result time placed in the hospitalization / in a day / within 24 h of a dose",
      "used_by": [
        "CMS816: Glucose Test With Result Less Than 40",
        "CMS871: Days with Glucose Results"
      ]
    },
    {
      "role": "glucose_result",
      "resource": "Observation",
      "element": "status in final | amended | corrected",
      "rule": "data requirement status filter",
      "used_by": [
        "both measures"
      ]
    },
    {
      "role": "medication_cms816",
      "resource": "MedicationAdministration",
