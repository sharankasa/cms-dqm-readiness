      "used_by": [
        "CMS871: Encounter with Hypoglycemic Medication"
      ]
    },
    {
      "role": "medication_cms816",
      "resource": "MedicationAdministration",
      "element": "effective[x] start",
      "rule": "dose start within the hospitalization and within 24 h before a low result",
      "used_by": [
        "CMS816: Hypoglycemic Medication Administration, Severe Hypoglycemic Harm Event"
      ]
    },
    {
      "role": "medication_cms871",
      "resource": "MedicationAdministration",
      "element": "effective[x] with an end",
      "rule": "the whole administration period must lie in the hospitalization; a period without an end never does",
      "used_by": [
        "CMS871: Encounter with Hypoglycemic Medication"
      ]
    },
    {
      "role": "medication_cms816",
      "resource": "MedicationAdministration",
      "element": "RxNorm code at the term types the value set lists",
      "rule": "value-set membership is exact on code; a brand or ingredient code of the same drug does not match",
      "used_by": [
        "both measures"
      ]
    },
    {
      "role": "medication_cms816",
      "resource": "MedicationAdministration",
      "element": "status consistent with the recorded eMAR event",
      "rule": "a not-given dose recorded as completed counts as a dose (MIMIC-specific: the event is kept in dosage.method)",
      "used_by": [
        "CMS816: Hypoglycemic Medication Administration",
        "CMS871: Encounter with Hypoglycemic Medication"
      ]
    },
    {
      "role": "encounter",
      "resource": "Encounter",
      "element": "status = finished; period start and end",
      "rule": "inpatient encounter ending in the measurement period",
      "used_by": [
